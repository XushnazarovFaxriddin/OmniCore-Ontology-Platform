# OmniCore Ontology Platform - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# General Settings
# =============================================================================
OMNICORE_ENV=development
OMNICORE_LOG_LEVEL=INFO

# =============================================================================
# Database Settings
# =============================================================================
# Path where SQLite databases will be stored
DATABASE_PATH=./data

# =============================================================================
# Service URLs (Internal Communication)
# =============================================================================
ROOTS_SERVICE_URL=http://roots-service:8001
CAUSALITY_SERVICE_URL=http://causality-service:8002
EPISTEMIC_SERVICE_URL=http://epistemic-service:8003
MMO_SERVICE_URL=http://mmo-service:8004
GLOBAL_SERVICE_URL=http://global-ontology-service:8005

# =============================================================================
# Authentication Settings
# =============================================================================
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Key header name
API_KEY_HEADER=X-API-Key

# Comma-separated list of valid API keys (leave empty for development)
VALID_API_KEYS=

# =============================================================================
# Redis Settings (for Rate Limiting)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# Rate limiting configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# =============================================================================
# Frontend Settings
# =============================================================================
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:8000/api

# =============================================================================
# GPU Settings (for Causality and Gateway services)
# =============================================================================
# Causality Service uses GPU 0
# Gateway Service uses GPU 1
# These are configured in podman-compose.yml
